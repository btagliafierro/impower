@article{FSI::Yilmaz_2021_sluiceGate,
 abstract = {This paper presents a newly-designed experimental setup based on the interaction of a dam-break flow with an elastic sluice gate in the context of the hydroelasticity problems. As the experimental measurement, displacements of the elastic sluice gate and water level evolutions at various points, calculated from the digital video images, are used. The present phenomenon includes violent free-surface motions with the rotational flow, hydraulic jump, and spilling type wave break, and both the static and dynamic impacts of that motions on the boundaries. Therefore, the experiment was repeated two times for testing the stability of the experimental process and measurements and, the obtained results were compared. The present phenomenon also was modeled numerically using the coupled SPH-FEM model and, the numerical computations were compared with experimental measurements.},
 author = {Ada Yilmaz and Selahattin Kocaman and Mustafa Demirci},
 doi = {https://doi.org/10.1016/j.oceaneng.2021.108870},
 issn = {0029-8018},
 journal = {Ocean Engineering},
 keywords = {Hydroelasticity, Fluid-structure interaction (FSI), Dam-break flow, Smoothed particle hydrodynamics (SPH), Sluice gate},
 pages = {108870},
 title = {Numerical modeling of the dam-break wave impact on elastic sluice gate: A new benchmark case for hydroelasticity problems},
 url = {https://www.sciencedirect.com/science/article/pii/S002980182100305X},
 volume = {231},
 year = {2021}
}

