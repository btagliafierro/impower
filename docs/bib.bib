@inproceedings{bona:tagliafierro_investigation_2023,
 abstract = {Focused waves are becoming an alternative tool to simulate harsh conditions for floating structures. The definition of a group of focusing waves, however, requires the configuration of several parameters. The choice of the focusing position is, in principle, critical depending on its location with respect to the structure’s, as their distance is heavily influenced by the particular drift imposed by waves and/or currents, and sometimes by winds. Particularly interesting is the coupling of regular background waves and focused wave groups. The proposed research investigates the sensitivity of the maximum loads in the mooring system of the Uppsala WEC to the wave characteristics by considering a parametric description of the design conditions, i.e.: damping of the PTO system, regular wave body duration, phase lag between regular and focused group, and the focusing position. © 2023 the Author(s).},
 author = {Tagliafierro, B. and Göteman, M. and Engström, J. and Martínez-Estévez, I. and Domínguez, J.M. and Crespo, A.J.C. and Gómez-Gesteira, M. and Altomare, C.},
